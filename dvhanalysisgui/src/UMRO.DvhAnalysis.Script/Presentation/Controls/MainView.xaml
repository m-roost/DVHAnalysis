<UserControl x:Class="UMRO.DvhAnalysis.Script.Presentation.Controls.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:v="clr-namespace:VMS.TPS.Common.Model.Types;assembly=VMS.TPS.Common.Model.Types"
        xmlns:t="clr-namespace:UMRO.Utils.FlexibleTitleBar;assembly=UMRO.Utils.FlexibleTitleBar"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:converters="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.Converters"
        xmlns:controls="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.ViewModels.Controls"
        xmlns:l="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.ViewModels.DVHModels"
        xmlns:metrics="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.ViewModels.Metrics"
        mc:Ignorable="d" FontSize="{DynamicResource FontSize}"
        Loaded="MainWindowLoaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources.xaml" />
                <ResourceDictionary Source="../../Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Defines a blank button (used to use an image as a button) -->
            <Style x:Key="BlankButton" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Defines a red cross symbol (used for deleting a metric) -->
            <ControlTemplate x:Key="DeleteSymbol" TargetType="{x:Type Button}">
                <Grid>
                    <Border Width="12" Height="12"
                            Background="Transparent">
                        <Grid>
                            <Path Fill="{StaticResource ControlWarningBrush}">
                                <Path.Data>
                                    <EllipseGeometry Center="6 6" RadiusX="6" RadiusY="6" />
                                </Path.Data>
                            </Path>
                            <Path Width="12" Height="12"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Data="M 3 3 L 9 9 M 3 9 L 9 3" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- Defines a blue plus symbol (used for adding a metric) -->
            <ControlTemplate x:Key="AddSymbol" TargetType="{x:Type Button}">
                <Grid>
                    <Border Width="12" Height="12"
                            Background="Transparent">
                        <Grid>
                            <Path Fill="{StaticResource ControlDarkBrush}">
                                <Path.Data>
                                    <EllipseGeometry Center="6 6" RadiusX="6" RadiusY="6" />
                                </Path.Data>
                            </Path>
                            <Path Width="8" Height="8"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Data="M 0 4 H 8 M 4 0 V 8" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- Defines a type converter to test for types -->
            <converters:TypeConverter x:Key="TypeConverter" />

            <!-- Sort the templates -->
            <CollectionViewSource
                x:Key="TemplatesView"
                Source="{Binding TemplatesViewModel.UserTemplates}"
                >
                <CollectionViewSource.SortDescriptions>
                    <componentModel:SortDescription PropertyName="GroupName" />
                    <componentModel:SortDescription PropertyName="Name" />
                </CollectionViewSource.SortDescriptions>
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="GroupName" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Main contents -->
            <RowDefinition Height="40"/>    <!-- Bottom buttons -->
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <t:TitleBar Name="TitleBar"
            Grid.Row="0"
            ShowClinicalWarning="False"
            UseSignatureLogo="False"
            ProductName="{Binding ProductName}"
            PatientId="{Binding Patient.Id}"
            PatientLastName="{Binding Patient.LastName}"
            PatientFirstName="{Binding Patient.FirstName}"
            ShowCourseAndPlan="False"
            UserName="{Binding User.Id}"
            ProductVersion="{Binding ProductVersion}"
            HelpUri="{Binding HelpUri}">
        </t:TitleBar>

        <!-- Main contents -->
        <Grid Grid.Row="1" Margin="{StaticResource BorderSpace}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />    <!-- Left panel -->
                <ColumnDefinition Width="4*" />   <!-- Right panel (metrics/volume) -->
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Templates -->
                    <RowDefinition Height="*"    />  <!-- Structures -->
                </Grid.RowDefinitions>

                <!-- Templates -->
                <StackPanel Grid.Row="0">
                    <!-- Header -->
                    <Label Content="Templates" Margin="{StaticResource TopSpace}"
                           Style="{StaticResource SectionHeader}" />

                    <!-- Label for templates -->
                    <TextBlock Margin="{StaticResource TopSpace}"
                               Text="Choose a template to load:" />

                    <!-- Available templates to load -->
                    <ComboBox Name="TemplatesComboBox"
                              Margin="{StaticResource TopSpace}"
                              DataContext="{Binding TemplatesViewModel}"
                              ItemsSource="{Binding Source={StaticResource TemplatesView}}"
                              DisplayMemberPath="Name">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource ControlDarkBrush}"
                                                   FontWeight="Bold" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>

                    <StackPanel Margin="{StaticResource TopSpace}"
                                Orientation="Horizontal">

                        <!-- Button for applying selected template -->
                        <Button Width="100" Height="32"
                                Content="Apply"
                                Click="ApplySelectedTemplate" />

                        <!-- Button for creating a new template -->
                        <Button Margin="{StaticResource LeftSpace}"
                                Width="100" Height="32"
                                Content="Create New"
                                Click="CreateTemplate" />

                    </StackPanel>
                </StackPanel>

                <!-- Structures -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Header -->
                        <RowDefinition Height="*"    />  <!-- Structures list -->
                        <RowDefinition Height="Auto" />  <!-- Add/Remove buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Label Grid.Row="0" Content="Structures" Margin="0,5,0,0"
                               Style="{StaticResource SectionHeader}" />

                    <!-- List of structures -->
                    <ItemsControl Grid.Row="1" Margin="0,5,0,0"
                                  ItemsSource="{Binding StructureViewModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource ControlHighlightBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Button Padding="4"
                                            Command="{Binding DataContext.AddMetricRowCommand,
                                                      RelativeSource={RelativeSource FindAncestor,
                                                          AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Margin="4"
                                                            Style="{StaticResource BlankButton}"
                                                            Template="{StaticResource AddSymbol}"
                                                            Command="{Binding DataContext.AddMetricRowCommand,
                                                                      RelativeSource={RelativeSource FindAncestor,
                                                                          AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />

                                                    <TextBlock Grid.Column="1" Margin="2"
                                                               Text="{Binding Id}"
                                                               Foreground="{StaticResource TextNormalBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add/Remove buttons -->
                    <StackPanel Grid.Row="2" Margin="0,5,0,0"
                                Orientation="Horizontal">
                        <Button Content="Add All"
                                Width="100" Height="32"
                                Command="{Binding AddAllStructuresCommand}" />

                        <Button Content="Remove All" Margin="5,0,0,0"
                                Width="100" Height="32"
                                Command="{Binding RemoveAllStructuresCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right panel (metrics/volumes) -->
            <TabControl Grid.Column="1" Margin="{StaticResource LeftLargeSpace}">
                <TabItem Name="Metrics" Header="Metrics">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />   <!-- Metrics data grid -->
                            <ColumnDefinition Width="256" /> <!-- Metric editor -->
                        </Grid.ColumnDefinitions>

                        <!-- Metrics data grid -->
                        <DataGrid Name="dtaMetrics" Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  ItemsSource="{Binding MetricRows}"
                                  SelectedItem="{Binding SelectedMetricRow}"
                                  SelectionChanged="OnMetricRowSelectionChanged"
                                  IsReadOnly="True" FrozenColumnCount="1"
                                  CanUserResizeRows="False" CanUserSortColumns="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="None"
                                  ColumnReordered="dtaMetrics_ColumnReordered"
                                  ColumnHeaderStyle="{DynamicResource ContextMenuStyle}">

                            <DataGrid.Resources>
                                <ContextMenu x:Key="ColumnHeaderContextMenu"
                                             ItemsSource="{Binding DataContext.PlanViewModels,
                                                           RelativeSource={RelativeSource FindAncestor,
                                                               AncestorType=UserControl}}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="IsCheckable" Value="True" />
                                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>

                                <Style x:Key="ContextMenuStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderContextMenu}" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Metric"
                                                        CanUserReorder="False"
                                                        Width="200">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Grid>
                                                            <ContentPresenter Margin="4,0"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Metric -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"   />    <!-- Delete symbol -->
                                                    <ColumnDefinition Width="*" />         <!-- Metric combobox -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Delete symbol -->
                                                <Button Grid.Column="0" Margin="4,2"
                                                        Style="{DynamicResource BlankButton}"
                                                        Template="{DynamicResource DeleteSymbol}"
                                                        Click="OnDeleteButtonClick" />

                                                <!-- Metric combobox -->
                                                <!-- Note: UpdateSourceTrigger=PropertyChanged is necessary for binding to work -->
                                                <ComboBox Grid.Column="1" Margin="2"
                                                          ItemsSource="{Binding AllDVHMetricSetups}"
                                                          SelectedItem="{Binding SelectedDVHMetricSetupViewModel, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="Name"
                                                          VerticalContentAlignment="Center">
                                                    <ComboBox.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <!--see UpdateSortingAndGrouping in code behind, which actually bind to TypeName instead of name of -->
                                                                    <!-- When you use a CollectionViewSource with PropertyGroupDescription to group items, WPF creates groups based on the value of the property you specify. Each group then has a Name property, which corresponds to the value of the property that was used to create the group. -->
                                                                    <TextBlock Text="{Binding Name, StringFormat=\{0\} Metrics}"
                                                                               Foreground="{StaticResource ControlDarkBrush}"
                                                                               FontWeight="Bold" />
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ComboBox.GroupStyle>
                                                </ComboBox>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="4,0,0,0"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource ControlDarkBrush}"
                                                       FontWeight="Bold" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    Margin="10,0,5,0">

                            <!-- Metric editor -->
                            <!-- Ideally, this should be its own control, having its own
                                 view model since it is also used by the MetricEditor.xaml -->
                            <UserControl Grid.Row="0" Name="MetricEditor"
                                         DataContext="{DynamicResource MetricEditorViewModel}">
                                <UserControl.Resources>
                                    <controls:MetricEditorViewModel x:Key="MetricEditorViewModel" />

                                    <!-- Defines a style to disable control if DVH model type is bio-dose -->
                                    <Style x:Key="DisableIfBioDose" TargetType="{x:Type RadioButton}"
                                           BasedOn="{StaticResource {x:Type RadioButton}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=., Converter={StaticResource TypeConverter}}"
                                                         Value="{x:Type l:LQBioDoseDVHModelViewModel}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=., Converter={StaticResource TypeConverter}}"
                                                         Value="{x:Type l:LQLBioDoseDVHModelViewModel}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- Defines a style to disable control if selected metric is null -->
                                    <Style x:Key="DisableIfSelectedMetricIsNull"
                                           TargetType="{x:Type FrameworkElement}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- Defines a style for a parameter label -->
                                    <Style x:Key="ParameterLabel" TargetType="{x:Type Label}">
                                        <Setter Property="Margin" Value="{StaticResource TopSpace}" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>

                                    <!-- Defines a style for simple parameter text box -->
                                    <Style x:Key="ParameterTextBox"
                                           TargetType="{x:Type TextBox}"
                                           BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Margin" Value="{StaticResource TopSpace}" />
                                        <Setter Property="Width" Value="60" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </UserControl.Resources>

                                <StackPanel DataContext="{Binding SelectedDVHMetricSetup}"
                                            Name="MetricEditorPanel"
                                            Style="{StaticResource DisableIfSelectedMetricIsNull}">
                                    <!-- Metric Properties label -->
                                    <Label Content="Metric Properties"
                                       Style="{StaticResource SectionHeader}" />

                                    <!-- Metric type -->
                                    <Grid Margin="{StaticResource TopLargeSpace}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Label -->
                                            <ColumnDefinition Width="*"    /> <!-- Combo box of metrics -->
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Content="Metric type:" />

                                        <!-- List of metrics to choose from -->
                                        <!-- TODO: Need a converter from type to string -->
                                        <ComboBox Grid.Column="1" Margin="{StaticResource LeftSpace}"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding AllMetricTypes, Source={StaticResource MetricEditorViewModel}}"
                                              SelectedItem="{Binding SelectedMetricType, Source={StaticResource MetricEditorViewModel}}"
                                              IsEnabled="False" />
                                    </Grid>

                                    <!-- Specific metric parameters -->
                                    <!-- Choose the correct DataTemplate based on the Metric type -->
                                    <UserControl DataContext="{Binding MetricViewModel}"
                                             Margin="{StaticResource TopLargeSpace}">
                                        <UserControl.Resources>
                                            <DataTemplate DataType="{x:Type metrics:MeanDoseMetricViewModel}" />
                                            <DataTemplate DataType="{x:Type metrics:MinDoseMetricViewModel}" />
                                            <DataTemplate DataType="{x:Type metrics:MaxDoseMetricViewModel}" />
                                            <DataTemplate DataType="{x:Type metrics:SMPCMetricViewModel}" />
                                            <DataTemplate DataType="{x:Type metrics:StdDevDoseMetricViewModel}" />
                                            <DataTemplate DataType="{x:Type metrics:DoseToVolumeMetricViewModel}">
                                                <!-- Amount of volume -->
                                                <UniformGrid Rows="1" Columns="2">
                                                    <Label Content="Volume:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBox Text="{Binding Volume}"
                                                                 Style="{StaticResource ParameterTextBox}" />
                                                        <TextBlock Margin="{StaticResource LeftSpace}"
                                                                   Height="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="%" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=VolumeIsAbsolute}"
                                                                                     Value="True">
                                                                            <Setter Property="Text" Value="cc" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type metrics:VolumeWithDoseMetricViewModel}">
                                                <!-- Amount of dose -->
                                                <UniformGrid Rows="1" Columns="2">
                                                    <Label Content="Dose:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBox Text="{Binding Dose}"
                                                             Style="{StaticResource ParameterTextBox}" />
                                                        <TextBlock Margin="{StaticResource LeftSpace}"
                                                                   Height="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="%" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DoseIsAbsolute}"
                                                                                     Value="True">
                                                                            <Setter Property="Text" Value="Gy" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type metrics:ColdVolumeWithDoseMetricViewModel}">
                                                <!-- Amount of dose -->
                                                <UniformGrid Rows="1" Columns="2">
                                                    <Label Content="Dose:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBox Text="{Binding Dose}"
                                                             Style="{StaticResource ParameterTextBox}" />
                                                        <TextBlock Margin="{StaticResource LeftSpace}"
                                                                   Height="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="%" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=DoseIsAbsolute}"
                                                                                     Value="True">
                                                                            <Setter Property="Text" Value="Gy" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type metrics:DoseComplementToVolumeMetricViewModel}">
                                                <!-- Amount of volume -->
                                                <UniformGrid Rows="1" Columns="2">
                                                    <Label Content="Volume:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBox Text="{Binding Volume}"
                                                                 Style="{StaticResource ParameterTextBox}" />
                                                        <TextBlock Margin="{StaticResource LeftSpace}"
                                                                   Height="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="%" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=VolumeIsAbsolute}"
                                                                                     Value="True">
                                                                            <Setter Property="Text" Value="cc" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type metrics:NTCPMetricViewModel}">
                                                <UniformGrid Rows="3" Columns="2">
                                                    <!-- LKBn -->
                                                    <Label Content="n:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding LKBn}"
                                                         Style="{StaticResource ParameterTextBox}" />

                                                    <!-- LKBm -->
                                                    <Label Content="m:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding LKBm}"
                                                         Style="{StaticResource ParameterTextBox}" />

                                                    <!-- LKBD50 -->
                                                    <Label Content="TD50:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding LKBD50}"
                                                         Style="{StaticResource ParameterTextBox}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type metrics:EUDMetricViewModel}">
                                                <!-- a -->
                                                <UniformGrid Rows="1" Columns="2">
                                                    <Label Content="a:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding a}"
                                                         Style="{StaticResource ParameterTextBox}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                        </UserControl.Resources>

                                        <UserControl.Template>
                                            <ControlTemplate TargetType="{x:Type UserControl}">
                                                <ContentPresenter Content="{Binding}" />
                                            </ControlTemplate>
                                        </UserControl.Template>
                                    </UserControl>

                                    <!-- DVH Model Properties label -->
                                    <Label Content="DVH Model Properties"
                                       Margin="{StaticResource TopLargeSpace}"
                                       Style="{StaticResource SectionHeader}" />

                                    <!-- DVH Model type -->
                                    <Grid Margin="{StaticResource TopLargeSpace}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Label -->
                                            <ColumnDefinition Width="*"    /> <!-- Combo box of DVH models -->
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Content="DVH model type:" />

                                        <!-- List of DVH models to choose from -->
                                        <!-- TODO: Need a converter from type to string -->
                                        <ComboBox Grid.Column="1" Margin="{StaticResource LeftSpace}"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding AllDVHModelTypes, Source={StaticResource MetricEditorViewModel}}"
                                              SelectedItem="{Binding SelectedDVHModelType, Source={StaticResource MetricEditorViewModel}}"
                                              DropDownClosed="OnDVHModelTypeComboBoxDropDownClosed"/>
                                    </Grid>

                                    <!-- Dose and volume types -->
                                    <Grid DataContext="{Binding DVHModelViewModel}"
                                          Margin="{StaticResource TopLargeSpace}">

                                          <Grid.Style>
                                            <!-- Hide if metric type is NTCP or EUD -->
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.MetricViewModel,
                                                        RelativeSource={RelativeSource FindAncestor, AncestorType=StackPanel},
                                                        Converter={StaticResource TypeConverter}}" Value="{x:Type metrics:NTCPMetricViewModel}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.MetricViewModel,
                                                        RelativeSource={RelativeSource FindAncestor, AncestorType=StackPanel},
                                                        Converter={StaticResource TypeConverter}}" Value="{x:Type metrics:EUDMetricViewModel}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition /> <!-- Dose type -->
                                            <ColumnDefinition /> <!-- Volume type -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Dose type -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical">

                                            <Label Content="Dose type:" />

                                            <!-- Absolute radio button -->
                                            <RadioButton Name="DoseIsAbsolute" Content="Absolute"
                                                     Margin="{StaticResource TopSpace}"
                                                     IsChecked="{Binding DoseType,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static v:DoseValuePresentation.Absolute}}" />

                                            <!-- Relative radio button -->
                                            <RadioButton Content="Relative"
                                                     IsChecked="{Binding DoseType,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static v:DoseValuePresentation.Relative}}"
                                                     Style="{StaticResource DisableIfBioDose}" />
                                        </StackPanel>

                                        <!-- Volume type -->
                                        <StackPanel Grid.Column="1" Orientation="Vertical">

                                            <Label Content="Volume type:" />

                                            <!-- Absolute radio button -->
                                            <RadioButton Name="VolumeIsAbsolute" Content="Absolute"
                                                     Margin="{StaticResource TopSpace}"
                                                     IsChecked="{Binding VolumeType,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static v:VolumePresentation.AbsoluteCm3}}" />

                                            <!-- Relative radio button -->
                                            <RadioButton Content="Relative"
                                                     IsChecked="{Binding VolumeType,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static v:VolumePresentation.Relative}}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Specific DVH model parameters -->
                                    <!-- Choose the correct DataTemplate based on the DVH model type -->
                                    <UserControl DataContext="{Binding DVHModelViewModel}"
                                                 Margin="{StaticResource TopLargeSpace}">
                                        <UserControl.Resources>
                                            <DataTemplate DataType="{x:Type l:StandardDVHModelViewModel}" />
                                            <DataTemplate DataType="{x:Type l:LQBioDoseDVHModelViewModel}">
                                                <UniformGrid Rows="1" Columns="2">
                                                    <!-- Alpha/beta -->
                                                    <Label Content="&#945;/&#946;:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding AlphaBeta}"
                                                         Style="{StaticResource ParameterTextBox}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type l:LQLBioDoseDVHModelViewModel}">
                                                <UniformGrid Rows="2" Columns="2">
                                                    <!-- Alpha/beta -->
                                                    <Label Content="&#945;/&#946;:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding AlphaBeta}"
                                                         Style="{StaticResource ParameterTextBox}" />

                                                    <!-- DT -->
                                                    <Label Content="DT:"
                                                       Style="{StaticResource ParameterLabel}" />
                                                    <TextBox Text="{Binding DT}"
                                                         Style="{StaticResource ParameterTextBox}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                        </UserControl.Resources>

                                        <UserControl.Template>
                                            <ControlTemplate TargetType="{x:Type UserControl}">
                                                <ContentPresenter Content="{Binding}" />
                                            </ControlTemplate>
                                        </UserControl.Template>
                                    </UserControl>

                                </StackPanel>
                            </UserControl>

                            <Button Grid.Row="1" Margin="{StaticResource TopLargeSpace}"
                                    Content="Recalculate"
                                    Height="32" Width="100"
                                    IsEnabled="{Binding IsEnabled, ElementName=MetricEditorPanel}"
                                    Click="OnRecalculateClick" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Name="Volumes" Header="Volumes">
                    <DataGrid Name="dtaVolumes" Margin="5"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding Volumes}"
                              IsReadOnly="True"
                              FrozenColumnCount="1"
                              GridLinesVisibility="None"
                              ColumnReordered="dtaVolumes_ColumnReordered">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Structure.Id}" Width="150"
                                                Header="ROI" CanUserReorder="False">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="Height" Value="24" />
                                        <Setter Property="TextBlock.HorizontalAlignment" Value="Left" />
                                        <Setter Property="TextBlock.Margin" Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"
                          Width="5" Background="Transparent" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="10,0,10,10">
            <Button Name="btnDVH" Content="View DVHs"
                    Width="125" Height="32"
                    Click="btnDVH_Click"/>
            <Button Name="btnExcel" Content="Export to Excel..." Margin="10,0,0,0"
                    Width="125" Height="32"
                    Click="btnExcel_Click" />
            <Button Name="btnSaveToDB" Content="Save to Database..." Margin="10,0,0,0"
                    Width="125" Height="32"
                    Click="btnSaveToDB_Click" />
            <Button Name="btnBioEvalReport" Content="BioEval Report..." Margin="10,0,0,0"
                    Width="125" Height="32"
                    Click="btnBioEvalReport_Click" />
            <Button Content="Metrics..." Margin="10,0,0,0"
                    Width="125" Height="32"
                    Click="ShowCustomMetricDialog" />
            <Button Content="Templates..." Margin="10,0,0,0"
                    Width="125" Height="32"
                    Click="ShowTemplatesDialog" />
        </StackPanel>
    </Grid>
</UserControl>
