<Window x:Class="UMRO.DvhAnalysis.Script.Presentation.Controls.SaveToDBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.Controls"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:converters="clr-namespace:UMRO.DvhAnalysis.Script.Presentation.Converters"
        mc:Ignorable="d"
        Title="DVHAnalysis Save To Database Window" Height="450" Width="800"
        Loaded="SaveToDBWindowLoaded"
        WindowStartupLocation="CenterScreen"
        >

    <Window.Resources>
        <Style x:Key="WrappedTextCellStyle" TargetType="DataGridCell">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    

    <DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <!--<Button Margin="4" Padding="10 4" Click="Button_SelectAll_Click">Select All</Button>-->
            <!--<Button Margin="4" Padding="10 4" Click="Button_UnSelectAll_Click">Un-select All</Button>-->
            <Button Margin="4" Padding="10 4" Click="Button_Save_Click"
                    ToolTip="Clicking this button will save all the metrics displayed above to database, and label the selected metrics as being used for the clinical decision.">
                Save all metrics and mark the selected ones
            </Button>

            <Button Margin="4" Padding="10 4" Click="Button_View_PDF_Click" ToolTip="View PDF of this table" >View PDF</Button>

            <Button Margin="4" Padding="10 4" Click="Button_Upload_PDF_Click" ToolTip="PDF of this table will be uploaded to Aria Patient Document">Upload PDF</Button>
            
            <Button Margin="4" Padding="10 4" Click="Button_Cancel_Click" >Cancel</Button>

            <CheckBox Name="CBox_isReIrradiation" VerticalAlignment="Center" Content="Is Re-Irradiation Evaluation" />
            
        </StackPanel>
        
        <DataGrid Name="dtaMetrics" Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  
                                  FrozenColumnCount="1"
                                  CanUserResizeRows="False" CanUserSortColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  SelectionMode="Extended" SelectionUnit="Cell"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="All"
                                  >
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,0,0,0"
                                                       Text="{Binding Structure}"
                                                       FontWeight="Bold" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>
        
    </DockPanel>
</Window>
