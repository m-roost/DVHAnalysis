<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!-- !!! IMPORTANT !!! -->

    <!-- DO NOT edit this file -->
    <!-- DO NOT put secret in this file -->
    
    <!-- This file is tracked in the Git repo -->
    <!-- This file is not used by the program -->
    
    <!-- Create a new file named App.config in the same folder and edit in that file -->
    <!-- Make sure App.config is not tracked by Git -->
    

    
    <!-- Required - DVH Metric definition file and templates of metric groups. They are needed to run the script properly -->
    <add key="MetricsPath" value="...path_to...\dvhanalysisgui\resources\Metrics.xml" />
    <add key="TemplatesPath" value="...path_to...\dvhanalysisgui\resources\Templates.xml" />


    <!-- Optional - directory for log files. One file per Windows user per month is configured here
         (<username>_<yyyy-MM>.log in NLog.config). If empty/missing, logs fall back to %LocalAppData%\DVHAnalysis. -->
    <add key="LogDir" value="" />
    

    <!-- Optional - pdf user guide document -->
    <add key="DocPath" value="...path_to...\dvhanalysisgui\resources\DVHAnalysisScript.pdf" />

    
    <!-- Optional - Provide if need to save Serial numbers of patient/course/plansetup/plansum into Database with metric values, or to get exact Physican and Physicist fullnames in pdf report. 
    Encrypted connection strings to access Aria database VARIAN and VarianSharedFrameworkDatabase, and the PrivateKey to decrypt them-->
    <add key="PrivateKey" value="" />
    <add key="AriaConnString" value="" />
    <add key="AriaSfConnString" value="" />

    
    <!-- Optional - "Save metrics to DB" connection string. If omitted, metrics won't be able to be saved to database. Not encrypted. -->
    <add key="RoarConnString" value="" />


    <!-- Optional - Aria Document user account - used to upload pdf report to Eclipse Patient document-->
    <add key="AriaDocAddress" value="https://...servername...:...port.../Gateway/Service.svc/interop/rest/Process" />
    <add key="AriaDocUsername" value="" />
    <add key="AriaDocPassword" value="" />
    <add key="AriaDocApiKey" value="" />
    
    
  </appSettings>
</configuration>