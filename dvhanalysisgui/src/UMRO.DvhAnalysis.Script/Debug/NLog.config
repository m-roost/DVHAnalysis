<?xml version="1.0" encoding="utf-8" ?>
<nlog
  xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
  throwExceptions="false"
  >

  <!--
  See https://github.com/nlog/nlog/wiki/Configuration-file
  for information on customizing logging rules and outputs.
   -->
  <targets>
    <!-- One file per Windows user per month. The directory comes from the app's LogDir
         setting (published as ${gdc:item=logDir} by AppLog.Configure); if unset, logs fall
         back to %LocalAppData%\DVHAnalysis. ${date} is evaluated per write, so a new file
         is started automatically at each month boundary. -->
    <target name="log" xsi:type="File" createDirs="true"
            fileName="${whenEmpty:inner=${gdc:item=logDir}:whenEmpty=${specialfolder:folder=LocalApplicationData}\DVHAnalysis}\${windows-identity:domain=false}_${date:format=yyyy-MM}.log">
      <layout xsi:type="CsvLayout" delimiter="Tab" withHeader="false">
        <column layout="${longdate}"/>
        <column layout="${machinename}"/>
        <column layout="${windows-identity}"/>
        <column layout="${processid}"/>
        <column layout="${uppercase:${level}}"/>
        <column layout="${message}"/>
        <column layout="${exception:format=toString}"/>
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="log"/>
  </rules>

</nlog>
