<UserControl x:Class="UMRO.Utils.DVHViewer.DVHViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:UMRO.Utils.DVHViewer.Converters" xmlns:oxy="http://oxyplot.org/wpf">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <l:StringContainsConverter x:Key="StringContainsConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border BorderThickness="1" BorderBrush="#FF000000" Margin="2,2,2,2">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="25" />
        <RowDefinition Height="*" />
        <RowDefinition Height="25" />
        <RowDefinition Height="25" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <StackPanel Name="stkDVH" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Image Name="btnAll" Source="Images/selectall.png" Height="20" ToolTip="Select all curves" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseDown="btnAll_MouseDown" />
        <Image Name="btnNone" Source="Images/selectnone.png" Height="20" ToolTip="Unselect all curves" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseDown="btnNone_MouseDown" />
      </StackPanel>
      <ItemsControl Name="lstDVH" Grid.Column="0" Grid.Row="1" Margin="10,0,5,0" ItemsSource="{Binding DVHCurves}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Margin="2,0,2,0" IsChecked="{Binding IsVisible}" Click="CheckBox_Click">
              <ContentControl.Content>
                <StackPanel Orientation="Horizontal">
                  <Line X2="20" StrokeThickness="2" VerticalAlignment="Center">
                    <Shape.Stroke>
                      <SolidColorBrush Color="{Binding Color}" />
                    </Shape.Stroke>
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Line}">
                        <Setter Property="Shape.StrokeDashArray" Value="20" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding StructureId, Converter={StaticResource StringContainsConverter}, ConverterParameter=-LQ}">
                            <Setter Property="Shape.StrokeDashArray" Value="4,1" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding StructureId, Converter={StaticResource StringContainsConverter}, ConverterParameter=-LQL}">
                            <Setter Property="Shape.StrokeDashArray" Value="4,1,1,1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Line>
                  <TextBlock Margin="2,0,0,0" Text="{Binding StructureId}" />
                </StackPanel>
              </ContentControl.Content>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <oxy:PlotView Name="oxyControl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Margin="20,0,20,0" Model="{Binding MyModel}" />
      <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="DVH Type" HorizontalAlignment="Center" FontWeight="Bold" />
      <RadioButton Name="radCum" Grid.Row="3" Grid.Column="1" GroupName="dvhType" Content="Cumulative" HorizontalAlignment="Right" IsChecked="{Binding IsCumDVH}" Checked="dvhType_Checked" />
      <RadioButton Name="radDif" Grid.Row="3" Grid.Column="2" GroupName="dvhType" Content="Direct" Margin="8,0,0,0" HorizontalAlignment="Left" IsChecked="{Binding IsDifDVH}" Checked="dvhType_Checked" />
      <Label Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Content="Dose" HorizontalAlignment="Center" FontWeight="Bold" />
      <RadioButton Name="radDoseAbs" Grid.Row="3" Grid.Column="3" GroupName="doseType" Content="Absolute" HorizontalAlignment="Right" IsChecked="{Binding IsDoseAbsolute}" Checked="doseType_Checked" />
      <RadioButton Name="radDoseRel" Grid.Row="3" Grid.Column="4" GroupName="doseType" Content="Relative" Margin="8,0,0,0" HorizontalAlignment="Left" IsChecked="{Binding IsDoseRelative}" Checked="doseType_Checked" />
      <Label Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Content="Volume" HorizontalAlignment="Center" FontWeight="Bold" />
      <RadioButton Name="radVolAbs" Grid.Row="3" Grid.Column="5" GroupName="volType" Content="Absolute" HorizontalAlignment="Right" IsChecked="{Binding IsVolumeAbsolute}" Checked="volType_Checked" />
      <RadioButton Name="radVolRel" Grid.Row="3" Grid.Column="6" GroupName="volType" Content="Relative" HorizontalAlignment="Left" Margin="8,0,0,0" IsChecked="{Binding IsVolumeRelative}" Checked="volType_Checked" />
      <Button Name="bthReset" Grid.Row="2" Grid.RowSpan="2" Grid.Column="7" Content="Reset" Margin="10,0,10,0" VerticalAlignment="Center" Click="bthReset_Click" />
    </Grid>
  </Border>
</UserControl>
